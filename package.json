{
  "name": "dsh-memledger",
  "version": "0.1.0",
  "description": "DeepSeek Harness 决策台账工具：改动前查重与倒车预警，改动后沉淀「为什么」，让重复劳动和改回历史不再发生。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/ginorva/mem-ledger.git"
  },
  "homepage": "https://gitee.com/ginorva/mem-ledger#readme",
  "bugs": {
    "url": "https://gitee.com/ginorva/mem-ledger/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "ledger",
    "decision-log",
    "regression",
    "agent-memory"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/tools-smoke.mjs && node test/check-smoke.mjs && node test/requirement-smoke.mjs && node test/inject-rules-smoke.mjs && node test/client-view-smoke.mjs && node test/dashboard-empty-smoke.mjs"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  }
}
